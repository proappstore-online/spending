{
  "name": "spending",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @spending/web dev",
    "prebuild": "npx -y @proappstore/cli@latest check",
    "build": "pnpm --filter @spending/web build",
    "preview": "pnpm --filter @spending/web preview",
    "dev:marketing": "pnpm --filter @spending/marketing dev",
    "build:marketing": "pnpm --filter @spending/marketing build",
    "typecheck": "pnpm --filter @spending/web exec tsc -b",
    "test": "pnpm --filter @spending/web exec tsc -b && node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
